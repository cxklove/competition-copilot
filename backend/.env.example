# Server process environment reference only; CLI does not auto-load this file.
# Never put these variables in frontend/public environment or commit real values.
COPILOT_AGENTARTS_GATEWAY_URL=https://replace-runtime-access-domain.invalid
COPILOT_AGENTARTS_RUNTIME_NAME=competition-copilot
COPILOT_AGENTARTS_AUTHORIZATION=
# Optional version and gateway correlation label (not Domain identity).
# COPILOT_AGENTARTS_ENDPOINT=dev
# COPILOT_AGENTARTS_GATEWAY_USER_ID=transport-user

# Independent Local Demo LLM opt-in. Process environment only; never frontend.
COMPETITION_COPILOT_LLM_MODE=offline
# Cloud provider: openai (default), bigmodel, deepseek. Model is always explicit.
COMPETITION_COPILOT_LLM_PROVIDER=openai
COMPETITION_COPILOT_LLM_MODEL=
COMPETITION_COPILOT_LLM_BASE_URL=
COMPETITION_COPILOT_LLM_STRUCTURED_METHOD=
# Intent-only overrides. Blank: BigModel json_mode / 0.1; other providers unchanged.
COMPETITION_COPILOT_LLM_INTENT_STRUCTURED_METHOD=
COMPETITION_COPILOT_LLM_INTENT_TEMPERATURE=
COMPETITION_COPILOT_LLM_TIMEOUT_SECONDS=30
COMPETITION_COPILOT_LLM_API_KEY=
# Supply the selected provider's API key securely to the backend process only.
# OPENAI_API_KEY remains a fallback for openai only when the unified key is unset.
# Blank unified key is not a fallback. This example file is not auto-loaded.
# OpenAI Example: provider=openai; base/method blank retain existing defaults.
# BigModel Example (MODE=cloud; model must support JSON mode and Tool Calling):
# COMPETITION_COPILOT_LLM_PROVIDER=bigmodel
# COMPETITION_COPILOT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# COMPETITION_COPILOT_LLM_STRUCTURED_METHOD=function_calling
# COMPETITION_COPILOT_LLM_INTENT_STRUCTURED_METHOD=json_mode
# COMPETITION_COPILOT_LLM_INTENT_TEMPERATURE=0.1
# Intent defaults above apply even when generic STRUCTURED_METHOD=function_calling.
# Explanation / human clarification retain generic function_calling.
# DeepSeek Example (set MODE=cloud and an accessible Tool Calling model):
# COMPETITION_COPILOT_LLM_PROVIDER=deepseek
# COMPETITION_COPILOT_LLM_BASE_URL=https://api.deepseek.com
# COMPETITION_COPILOT_LLM_STRUCTURED_METHOD=function_calling
