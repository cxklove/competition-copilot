# Public development configuration only; never credentials.
# Leave mode unset to retain the offline fake workspace.
VITE_RUNTIME_MODE=LOCAL
# Empty uses the Vite same-origin development proxy.
VITE_LOCAL_RUNTIME_BASE_URL=
# Vite server-side proxy target (non-secret).
LOCAL_RUNTIME_PROXY_TARGET=http://127.0.0.1:8765
# To select AgentArts transport set VITE_RUNTIME_MODE=AGENTARTS.
# Public runtime name and bridge address only; NEVER cloud credentials.
VITE_AGENTARTS_RUNTIME_NAME=competition-copilot
VITE_AGENTARTS_BRIDGE_BASE_URL=
AGENTARTS_BRIDGE_PROXY_TARGET=http://127.0.0.1:8766
