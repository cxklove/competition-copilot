# Public development configuration only; never credentials.
# Leave mode unset to retain the offline fake workspace. AGENTARTS is deferred.
VITE_RUNTIME_MODE=LOCAL
# Empty uses the Vite same-origin development proxy.
VITE_LOCAL_RUNTIME_BASE_URL=
# Vite server-side proxy target (non-secret).
LOCAL_RUNTIME_PROXY_TARGET=http://127.0.0.1:8765
