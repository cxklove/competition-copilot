{
  "name": "competition-copilot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "lint": "tsc --noEmit && prettier --check src/runtime/*.ts tests/*.ts",
    "format": "prettier --write src/runtime/*.ts tests/*.ts",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
